{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)ustawienia.json' ':(exclude)partnerzy'",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/((?!api/logo).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
